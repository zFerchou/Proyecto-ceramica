{
  "name": "proyecto-ceramica-backend",
  "version": "1.0.0",
  "description": "Backend del proyecto integrador con Express, PostgreSQL y Swagger",
  "type": "module",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output backend.exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "app.js",
      "routes/**/*.js",
      "docs/**/*.js"
    ],
    "assets": [
      ".env"
    ]
  }
}
