{
  "name": "proyecto-ceramica-desktop",
  "version": "1.0.0",
  "description": "Electron wrapper for Proyecto Ceramica (frontend + backend)",
  "main": "electron/main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "cd backend && npm install && cd .. && cd frontend && npm install && cd ..",
    "build:frontend": "cd frontend && npm run build",
    "dev": "npm run build:frontend && electron .",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder --win --x64"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
  "appId": "com.proyecto.ceramica",
  "productName": "Proyecto Ceramica",
  "files": [
    "electron/**/*",
    "frontend/build/**/*"
  ],
  "extraResources": [
    {
      "from": "backend",
      "to": "backend"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  }
}
}